{
  "name": "Reading list",
  "short_name": "Reading list",
  "description": "Pages to read later, on the Mac and the phone.",
  "start_url": "./",
  "scope": "./",
  "id": "reading-list",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#eef0f3",
  "theme_color": "#eef0f3",
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./add.html",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "shortcuts": [
    {
      "name": "Capture a page",
      "short_name": "Capture",
      "url": "./?capture=1"
    },
    {
      "name": "Todos",
      "short_name": "Todos",
      "url": "./todos.html"
    }
  ]
}
