<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>nl.hoopyfroody.reading-list-heartbeat</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/matthijshakfoort/CODE/reading-list-design/tools/backfill-heartbeat.sh</string>
  </array>

  <!-- 09:00 local, daily. If the Mac is asleep at 09:00, launchd fires this
       once on wake. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardErrorPath</key>
  <string>/Users/matthijshakfoort/Library/Logs/reading-list-heartbeat.err</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
